{% extends 'base.html.twig' %}

{% block title %}Добавление подписки{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-dark text-white">
                    <h3 class="card-title mb-0 h5">
                        <i class="bi bi-plus-circle"></i> Добавление новой подписки
                    </h3>
                </div>
                <div class="card-body">

                    {{ form_start(form) }}

                    {% include 'subscription/_form_fields.html.twig' with {form: form} %}

                    {# Кнопки #}
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Сохранить подписку
                        </button>
                    </div>

                    {{ form_end(form) }}

                </div>
            </div>
        </div>
    </div>

    {% include 'subscription/_form_toggle_script.html.twig' with {form: form} %}
{% endblock %}
