<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Трекер подписок{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">SUBS-Tracker</a>
        <div class="navbar-nav">
            <a class="nav-link" href="{{ path('app_home') }}">Главная</a>
            {% if app.user %}
                <a class="nav-link" href="{{ path('app_my_subscriptions') }}">Мои подписки</a>
                <span class="navbar-text text-white me-3">Привет, {{ app.user.name }}!</span>
                <a class="btn btn-outline-light btn-sm" href="{{ path('user_logout') }}">Выйти</a>
            {% else %}
                <a class="nav-link text-white d-inline me-2" href="{{ path('user_login') }}">Вход</a>
                <a class="nav-link text-white d-inline" href="{{ path('user_register') }}">Регистрация</a>
            {% endif %}
        </div>
    </div>
</nav>

<div class="container mt-4">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {% block body %}{% endblock %}
</div>
</body>
</html>
